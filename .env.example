# Copy to .env.local for local dev. Never commit real keys.
# On Vercel, set these in Project Settings → Environment Variables.

# ── Required for photo analysis ──────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Set to true to serve a canned result and skip the paid API entirely.
# Useful for UI work and for running the app with no keys at all.
AI_MOCK=

# ── Optional: community posts and scan logging ───────────────
# The scanner works without these; only the community feed needs them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Optional: absolute URLs for share cards and QR codes ─────
# Falls back to VERCEL_URL, then to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# ── Optional: retarget the advisor at a different adhesive ───
# Every product string and outbound link is driven from these.
NEXT_PUBLIC_PRODUCT_NAME=
NEXT_PUBLIC_PRODUCT_IMAGE=
NEXT_PUBLIC_PACK_GRAMS=
NEXT_PUBLIC_VENDOR_HOME=
NEXT_PUBLIC_VENDOR_PRODUCTS=
NEXT_PUBLIC_VENDOR_KNOWLEDGE=
NEXT_PUBLIC_VENDOR_SUPPORT=
NEXT_PUBLIC_VENDOR_CONTACT=
NEXT_PUBLIC_VENDOR_SHOPEE=
NEXT_PUBLIC_VENDOR_LAZADA=
